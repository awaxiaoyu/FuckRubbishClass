<ui:FluentWindow x:Class="FuckRubbishClass.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewmodels="clr-namespace:FuckRubbishClass.ViewModels"
                 xmlns:views="clr-namespace:FuckRubbishClass.Views"
                 Title="FuckRubbishClass - 统一在线课程自动化工作台"
                 Width="1440"
                 Height="920"
                 MinWidth="1150"
                 MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <!-- ViewModel to View Mapping DataTemplates -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AccountsViewModel}">
            <views:AccountsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CourseHubViewModel}">
            <views:CourseHubView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FeaturesViewModel}">
            <views:FeaturesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ModelCenterViewModel}">
            <views:ModelCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TaskMonitorViewModel}">
            <views:TaskMonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Background="#F8FAFC">
        <!-- TitleBar -->
        <ui:TitleBar Title="FuckRubbishClass · 现代化统一课程工作台" ShowMaximize="True" ShowMinimize="True" ShowClose="True" />

        <!-- Main Window Container -->
        <Grid Margin="0,42,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT NAVIGATION SIDEBAR ================= -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid Margin="18,22,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Branding Logo -->
                    <Grid Grid.Row="0" Margin="4,0,4,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="40" Height="40" CornerRadius="12" Background="#1E3A8A">
                            <TextBlock Text="✦" FontSize="20" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FuckRubbishClass" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="UNIFIED WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Nav Section Header -->
                    <TextBlock Grid.Row="1" Text="WORKSPACE" Style="{StaticResource KickerTextStyle}" Margin="6,0,0,10" />

                    <!-- Navigation Items List -->
                    <ListBox x:Name="NavListBox" Grid.Row="2" BorderThickness="0" Background="Transparent" 
                             SelectedIndex="0">
                        
                        <!-- Dashboard -->
                        <ListBoxItem Tag="dashboard" Style="{StaticResource NavRailItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Home24" FontSize="18" Foreground="#2563EB" />
                                <TextBlock Grid.Column="1" Text="工作台总览" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                            </Grid>
                        </ListBoxItem>

                        <!-- Accounts -->
                        <ListBoxItem Tag="accounts" Style="{StaticResource NavRailItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Person24" FontSize="18" Foreground="#475569" />
                                <TextBlock Grid.Column="1" Text="多平台账号" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Padding="6,1" CornerRadius="8" Background="#EFF6FF">
                                    <TextBlock Text="{Binding AccountsVM.Accounts.Count, FallbackValue='3'}" FontSize="10" FontWeight="Bold" Foreground="#2563EB" />
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <!-- Courses -->
                        <ListBoxItem Tag="courses" Style="{StaticResource NavRailItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Book24" FontSize="18" Foreground="#475569" />
                                <TextBlock Grid.Column="1" Text="课程与任务" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Padding="6,1" CornerRadius="8" Background="#F1F5F9">
                                    <TextBlock Text="{Binding CourseHubVM.AllCourses.Count, FallbackValue='9'}" FontSize="10" FontWeight="Bold" Foreground="#475569" />
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <!-- Features -->
                        <ListBoxItem Tag="features" Style="{StaticResource NavRailItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Apps24" FontSize="18" Foreground="#475569" />
                                <TextBlock Grid.Column="1" Text="统一功能接入" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                            </Grid>
                        </ListBoxItem>

                        <!-- Models & Scheduler -->
                        <ListBoxItem Tag="models" Style="{StaticResource NavRailItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="18" Foreground="#7C3AED" />
                                <TextBlock Grid.Column="1" Text="模型配置与调度" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                            </Grid>
                        </ListBoxItem>

                        <!-- Task Monitor -->
                        <ListBoxItem Tag="tasks" Style="{StaticResource NavRailItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="History24" FontSize="18" Foreground="#475569" />
                                <TextBlock Grid.Column="1" Text="任务调度监控" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                            </Grid>
                        </ListBoxItem>

                        <!-- Settings -->
                        <ListBoxItem Tag="settings" Style="{StaticResource NavRailItemStyle}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="#475569" />
                                <TextBlock Grid.Column="1" Text="系统偏好设置" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                            </Grid>
                        </ListBoxItem>

                    </ListBox>

                    <!-- User Profile Bottom Card -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="30" Height="30" CornerRadius="15" Background="#2563EB">
                                <TextBlock Text="U" FontSize="13" FontWeight="Bold" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveAccountSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding BridgeStatusText}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>

                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= RIGHT MAIN CONTENT AREA ================= -->
            <Grid Grid.Column="1" Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Global Status Ribbon -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active Task Banner (if running) -->
                    <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,8"
                            Visibility="{Binding HasActiveTask, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Flash24" Foreground="#2563EB" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding TaskStatusSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- System Status Badge -->
                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="核心调度正常" FontSize="11" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Dynamic Content Viewer (Swaps Views via DataTemplates) -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />

                <!-- Bottom App Status Footer -->
                <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TaskStatusSummary, StringFormat='状态: {0}'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="FuckRubbishClass v2.0 · Fluent Edition" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</ui:FluentWindow>
