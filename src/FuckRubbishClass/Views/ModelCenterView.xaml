<UserControl x:Class="FuckRubbishClass.Views.ModelCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:FuckRubbishClass.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="950" d:DesignWidth="1100">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
            <StackPanel Margin="0,0,0,24">
                
                <!-- Page Header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="UNIFIED AI ENGINE &amp; SCHEDULER" Style="{StaticResource KickerTextStyle}" />
                        <TextBlock Text="模型配置与统一调度中心" Style="{StaticResource HeaderTitleStyle}" Margin="0,6,0,4" />
                        <TextBlock Text="打破各模块 AI 配置割裂：统一管理大模型节点，按做题、视觉、推理与课件解析角色智能路由与容灾降级。" 
                                   Style="{StaticResource SubheaderTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Secondary" Content="全量测速巡检" Icon="{ui:SymbolIcon Symbol=Flash24}" 
                                   Command="{Binding TestAllModelsCommand}" Padding="14,9" Margin="0,0,8,0" />
                        <ui:Button Appearance="Primary" Content="添加模型节点" Icon="{ui:SymbolIcon Symbol=Add24}" 
                                   Command="{Binding StartAddModelCommand}" Padding="16,9" />
                    </StackPanel>
                </Grid>

                <!-- Feedback Banner -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#2563EB" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#1E3A8A" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Edit / Add Model Flyout Form -->
                <Border Style="{StaticResource FluentCardElevatedStyle}" Margin="0,0,0,20" Background="#F8FAFC"
                        Visibility="{Binding IsEditingModel, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="模型配置与参数" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="支持任何兼容 OpenAI 协议的模型接口（DeepSeek, GPT-4o, Moonshot, Qwen, Ollama 等）。" 
                                           Style="{StaticResource SubheaderTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Quick Preset Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="加载预设: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:Button Content="DeepSeek" Padding="8,4" FontSize="11" Margin="0,0,4,0" Command="{Binding ApplyPresetCommand}" CommandParameter="DeepSeek" />
                                <ui:Button Content="DeepSeek-R1" Padding="8,4" FontSize="11" Margin="0,0,4,0" Command="{Binding ApplyPresetCommand}" CommandParameter="DeepSeekR1" />
                                <ui:Button Content="GPT-4o 视觉" Padding="8,4" FontSize="11" Margin="0,0,4,0" Command="{Binding ApplyPresetCommand}" CommandParameter="GPT4o" />
                                <ui:Button Content="Moonshot" Padding="8,4" FontSize="11" Margin="0,0,4,0" Command="{Binding ApplyPresetCommand}" CommandParameter="Moonshot" />
                                <ui:Button Content="本地 Ollama" Padding="8,4" FontSize="11" Command="{Binding ApplyPresetCommand}" CommandParameter="Ollama" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="配置名称" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如: DeepSeek-V3 快速推理" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                <TextBlock Text="服务提供商类型" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox SelectedValue="{Binding EditProvider}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="DeepSeek" Tag="{x:Static models:ModelProviderType.DeepSeek}" IsSelected="True" />
                                    <ComboBoxItem Content="OpenAI" Tag="{x:Static models:ModelProviderType.OpenAI}" />
                                    <ComboBoxItem Content="Moonshot / Kimi" Tag="{x:Static models:ModelProviderType.Moonshot}" />
                                    <ComboBoxItem Content="硅基流动 SiliconFlow" Tag="{x:Static models:ModelProviderType.SiliconFlow}" />
                                    <ComboBoxItem Content="本地 Ollama" Tag="{x:Static models:ModelProviderType.Ollama}" />
                                    <ComboBoxItem Content="自定义 OpenAI 兼容 API" Tag="{x:Static models:ModelProviderType.Custom}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="模型 ID (Model Name)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ui:TextBox Text="{Binding EditModelId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如: deepseek-chat" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Base URL (服务根路径，不要加 /chat/completions)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ui:TextBox Text="{Binding EditBaseUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://api.deepseek.com/v1" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="API Key (密钥)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ui:PasswordBox Password="{Binding EditApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{Binding EditTemperature, StringFormat='{}Temperature (温度): {0:F1}'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Slider Minimum="0.0" Maximum="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding EditTemperature}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                <TextBlock Text="{Binding EditMaxTokens, StringFormat='{}Max Tokens: {0}'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Slider Minimum="512" Maximum="8192" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding EditMaxTokens}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding EditTimeoutSeconds, StringFormat='{}超时时间: {0} 秒'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Slider Minimum="15" Maximum="180" TickFrequency="15" IsSnapToTickEnabled="True" Value="{Binding EditTimeoutSeconds}" />
                            </StackPanel>
                        </Grid>

                        <!-- Capabilities Toggles -->
                        <WrapPanel Margin="0,0,0,18">
                            <ui:ToggleSwitch Content="支持多模态视觉识图 (Vision)" IsChecked="{Binding EditSupportsVision}" Margin="0,0,20,0" />
                            <ui:ToggleSwitch Content="支持流式输出 (Stream)" IsChecked="{Binding EditSupportsStream}" Margin="0,0,20,0" />
                            <ui:ToggleSwitch Content="支持课件文档解析 (Document/PPT)" IsChecked="{Binding EditSupportsDocument}" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="取消" Command="{Binding CancelEditModelCommand}" Margin="0,0,8,0" Padding="16,8" />
                            <ui:Button Appearance="Primary" Content="确认保存模型配置" Command="{Binding SaveModelEditCommand}" Padding="18,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 1: Unified Model Pool Grid -->
                <TextBlock Text="已配置模型节点池" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Models}" Margin="0,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="340" Margin="0,0,16,16" Style="{StaticResource FluentCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Badges -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Border HorizontalAlignment="Left" Padding="8,3" CornerRadius="6" Background="#F1F5F9">
                                            <TextBlock Text="{Binding ProviderDisplayName}" FontSize="11" FontWeight="Bold" Foreground="{Binding ProviderBadgeColor}" />
                                        </Border>

                                        <!-- Latency Badge -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" 
                                                     Fill="{Binding LatencyMs, Converter={StaticResource LatencyToColorConverter}}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Name & ID -->
                                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock Text="{Binding ModelId, StringFormat='{}ID: {0}'}" FontSize="11" Foreground="#64748B" FontFamily="Consolas" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding BaseUrl}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Capabilities Pills -->
                                    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                                        <Border Padding="6,2" CornerRadius="4" Background="#ECFDF5" Margin="0,0,6,4"
                                                Visibility="{Binding SupportsVision, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="👁️ 视觉识图" FontSize="10" Foreground="#059669" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="4" Background="#EFF6FF" Margin="0,0,6,4"
                                                Visibility="{Binding SupportsStream, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="⚡ 流式响应" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="4" Background="#FAF5FF" Margin="0,0,6,4"
                                                Visibility="{Binding SupportsDocument, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="📄 课件解析" FontSize="10" Foreground="#7C3AED" FontWeight="SemiBold" />
                                        </Border>
                                    </WrapPanel>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Content="测速 (Ping)" Icon="{ui:SymbolIcon Symbol=Flash24}" Padding="8,5" FontSize="11"
                                                   Command="{Binding DataContext.TestSelectedModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />

                                        <ui:Button Grid.Column="1" Content="编辑" Icon="{ui:SymbolIcon Symbol=Edit24}" Margin="6,0,0,0" Padding="8,5" FontSize="11"
                                                   Command="{Binding DataContext.StartEditModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />

                                        <ui:Button Grid.Column="2" Appearance="Danger" Icon="{ui:SymbolIcon Symbol=Delete24}" Margin="6,0,0,0" Padding="8,5"
                                                   Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- SECTION 2: Unified Model Scheduler & Role Routing -->
                <Border Style="{StaticResource FluentCardElevatedStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="统一智能调度策略与分工角色映射" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="根据任务特点（快速客观题、视觉截图、深度推理、课件结构化）自动调度最合适的模型节点，并配备失败容灾降级方案。" 
                                           Style="{StaticResource SubheaderTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>

                            <ui:Button HorizontalAlignment="Right" Appearance="Primary" Content="保存调度策略" Icon="{ui:SymbolIcon Symbol=Save24}"
                                       Command="{Binding SaveSchedulerSettingsCommand}" Padding="16,8" />
                        </Grid>

                        <!-- 4 Roles Grid -->
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Role 1: Fast Solver -->
                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#EFF6FF" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="⚡ 快速做题角色 (Fast Solver)" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="用于单选/多选/判断等高频客观题，低延迟高并发。" FontSize="11" Foreground="#64748B" Margin="0,0,0,12" />

                                    <TextBlock Text="首选主模型:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedValue="{Binding Scheduler.FastSolverModelId}" 
                                              SelectedValuePath="Id" DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                                    <TextBlock Text="备用容灾降级模型:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedValue="{Binding Scheduler.FastSolverFallbackModelId}" 
                                              SelectedValuePath="Id" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <!-- Role 2: Vision Multimodal -->
                            <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#ECFDF5" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="Image24" FontSize="16" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="👁️ 视觉识图角色 (Vision OCR)" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="用于公式截图、图像辨析题、课件截图识别。" FontSize="11" Foreground="#64748B" Margin="0,0,0,12" />

                                    <TextBlock Text="首选主模型:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedValue="{Binding Scheduler.VisionModelId}" 
                                              SelectedValuePath="Id" DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                                    <TextBlock Text="备用容灾降级模型:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedValue="{Binding Scheduler.VisionFallbackModelId}" 
                                              SelectedValuePath="Id" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <!-- Role 3: Deep Reasoning -->
                            <Border Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#FAF5FF" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="16" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="🧠 深度推理角色 (Deep Reasoning)" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="用于期末考试主观分析题、辨析逻辑与疑难解答。" FontSize="11" Foreground="#64748B" Margin="0,0,0,12" />

                                    <TextBlock Text="首选主模型:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedValue="{Binding Scheduler.DeepReasoningModelId}" 
                                              SelectedValuePath="Id" DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                                    <TextBlock Text="备用容灾降级模型:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedValue="{Binding Scheduler.DeepReasoningFallbackModelId}" 
                                              SelectedValuePath="Id" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <!-- Role 4: Document Parser -->
                            <Border Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#FFFBEB" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="Document24" FontSize="16" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="📄 课件文档解析 (Document / PPT)" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="配合知到 AI 智能课，批量解析课件 PPT 文本大纲。" FontSize="11" Foreground="#64748B" Margin="0,0,0,12" />

                                    <TextBlock Text="首选主模型:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedValue="{Binding Scheduler.DocumentParserModelId}" 
                                              SelectedValuePath="Id" DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                                    <TextBlock Text="备用容灾降级模型:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedValue="{Binding Scheduler.DocumentParserFallbackModelId}" 
                                              SelectedValuePath="Id" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Scheduler Policies Toggles -->
                        <TextBlock Text="调度引擎全局规则" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12" />
                        <WrapPanel>
                            <ui:ToggleSwitch Content="遇到 429 / 5xx / 超时自动无缝降级备用节点" IsChecked="{Binding Scheduler.AutoFallbackOnFailure}" Margin="0,0,24,8" />
                            <ui:ToggleSwitch Content="发现题目包含公式图片时自动升阶至视觉模型" IsChecked="{Binding Scheduler.AutoUpgradeToVisionOnImages}" Margin="0,0,24,8" />
                            <ui:ToggleSwitch Content="启用流式响应加速" IsChecked="{Binding Scheduler.StreamResponse}" Margin="0,0,24,8" />
                            <ui:ToggleSwitch Content="在日志中完整记录 AI 思考推导链路" IsChecked="{Binding Scheduler.LogAiReasoningChain}" Margin="0,0,24,8" />
                        </WrapPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
