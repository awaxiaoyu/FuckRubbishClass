<UserControl x:Class="FuckRubbishClass.Views.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="850" d:DesignWidth="1100">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
            <StackPanel Margin="0,0,0,24">
                
                <!-- Page Header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="UNIFIED FEATURE WORKSPACE" Style="{StaticResource KickerTextStyle}" />
                        <TextBlock Text="统一功能接入工作台" Style="{StaticResource HeaderTitleStyle}" Margin="0,6,0,4" />
                        <TextBlock Text="重构整合视频自学、平时测试、考试中心、考勤签到与 AI 智能课，所有业务统一调度统一参数。" 
                                   Style="{StaticResource SubheaderTextStyle}" />
                    </StackPanel>

                    <ui:Button Grid.Column="1" Appearance="Primary" Content="保存功能参数" Icon="{ui:SymbolIcon Symbol=Save24}" 
                               Command="{Binding SaveAllConfigsCommand}" Padding="16,9" />
                </Grid>

                <!-- Feedback Banner -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#2563EB" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#1E3A8A" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Segmented Tab Switcher -->
                <Border Background="#F1F5F9" CornerRadius="12" Padding="4" Margin="0,0,0,18" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="📺 视频自学" Style="{x:Null}" Padding="16,8" Margin="0,0,4,0" IsChecked="True"
                                     Click="OnTabClicked" Tag="video" />
                        <RadioButton Content="📝 平时测验/作业" Style="{x:Null}" Padding="16,8" Margin="0,0,4,0"
                                     Click="OnTabClicked" Tag="homework" />
                        <RadioButton Content="🎯 考试中心" Style="{x:Null}" Padding="16,8" Margin="0,0,4,0"
                                     Click="OnTabClicked" Tag="exam" />
                        <RadioButton Content="⏱️ 课堂派考勤签到" Style="{x:Null}" Padding="16,8" Margin="0,0,4,0"
                                     Click="OnTabClicked" Tag="signin" />
                        <RadioButton Content="🤖 知到 AI 智能课" Style="{x:Null}" Padding="16,8"
                                     Click="OnTabClicked" Tag="aicourse" />
                    </StackPanel>
                </Border>

                <!-- Target Account & Course Selector Card (Shared) -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="执行账号" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="DisplayTitle"
                                      HorizontalAlignment="Stretch" Padding="10,8" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="目标课程" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" Padding="10,8" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TAB 1: Video Study Panel -->
                <Border Style="{StaticResource FluentCardElevatedStyle}" Margin="0,0,0,16"
                        Visibility="{Binding ActiveFeatureTab, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                    <StackPanel>
                        <TextBlock Text="视频自学参数配置" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="通用适配智慧树与学习通，智能处理实际播放时长与断点续播。" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding VideoConfig.PlaybackRate, StringFormat='{}播放倍速: {0}x'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Slider Minimum="0.5" Maximum="2.0" TickFrequency="0.25" IsSnapToTickEnabled="True" 
                                        Value="{Binding VideoConfig.PlaybackRate}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="{Binding VideoConfig.CompletionThreshold, StringFormat='{}完成阈值: {0:P0}'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Slider Minimum="0.80" Maximum="1.0" TickFrequency="0.01" IsSnapToTickEnabled="True" 
                                        Value="{Binding VideoConfig.CompletionThreshold}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="运行浏览器环境" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox SelectedValue="{Binding VideoConfig.BrowserType}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Microsoft Edge (本机)" Tag="msedge" IsSelected="True" />
                                    <ComboBoxItem Content="Google Chrome (本机)" Tag="chrome" />
                                    <ComboBoxItem Content="Chromium (无头后台)" Tag="headless" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,0,0,20">
                            <ui:ToggleSwitch Content="静音播放" IsChecked="{Binding VideoConfig.IsMuted}" Margin="0,0,20,0" />
                            <ui:ToggleSwitch Content="自动跳下一集" IsChecked="{Binding VideoConfig.AutoNext}" Margin="0,0,20,0" />
                        </WrapPanel>

                        <ui:Button Appearance="Primary" Content="启动视频自学任务" Icon="{ui:SymbolIcon Symbol=Play24}" 
                                   Command="{Binding StartVideoStudyCommand}" Padding="20,10" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- TAB 2: Homework & Quiz Panel -->
                <Border Style="{StaticResource FluentCardElevatedStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="平时测验与章节作业策略" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="分层解答管线：① 本地已验证题库 -> ② 答案图高精OCR -> ③ 统一调度模型池兜底 -> ④ 逐题保存保护。" 
                                   Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,16" />

                        <WrapPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch Content="图答案与题库覆盖旧答案" IsChecked="{Binding HomeworkConfig.OverwriteWithVerifiedAnswers}" Margin="0,0,20,8" />
                            <ui:ToggleSwitch Content="已交卷未满分自动重做 (最多3次)" IsChecked="{Binding HomeworkConfig.AutoRedoIfNotFullScore}" Margin="0,0,20,8" />
                            <ui:ToggleSwitch Content="作答成果沉淀至本地题库" IsChecked="{Binding HomeworkConfig.HarvestAnswersToBank}" Margin="0,0,20,8" />
                            <ui:ToggleSwitch Content="作答后自动交卷 (不可逆，需谨慎)" IsChecked="{Binding HomeworkConfig.AutoSubmit}" Margin="0,0,20,8" />
                        </WrapPanel>

                        <StackPanel Margin="0,0,0,20" MaxWidth="360" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding HomeworkConfig.AnswerDelaySeconds, StringFormat='{}单题作答间隔: {0:F1} 秒'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Slider Minimum="0.5" Maximum="5.0" TickFrequency="0.5" IsSnapToTickEnabled="True" 
                                    Value="{Binding HomeworkConfig.AnswerDelaySeconds}" />
                        </StackPanel>

                        <ui:Button Appearance="Primary" Content="开始作答当前课程测试" Icon="{ui:SymbolIcon Symbol=DocumentCheckmark24}" 
                                   Command="{Binding StartHomeworkQuizCommand}" Padding="20,10" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- TAB 3: Exam Assessment Panel -->
                <Border Style="{StaticResource FluentCardElevatedStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="考试中心与 AI 智能副驾" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="支持学习通与智慧树期末考试。提供 100% 安全只读 AI 辅助模式和全自动机考模式。" 
                                   Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Primary" Content="提取题面与 AI 解析 (安全只读)" Icon="{ui:SymbolIcon Symbol=Sparkle24}" 
                                           Command="{Binding RunExamReadonlyAnalysisCommand}" Padding="16,9" Margin="0,0,8,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="安全模式不会向考试服务器提交任何数据，纯本地解析展示。" 
                                       FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>

                        <!-- Readonly Result Preview Box -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                            <TextBox Text="{Binding ExamAnalysisResult}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="Consolas, Segoe UI" FontSize="12" Background="Transparent" BorderThickness="0"
                                     MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto" Foreground="#1E293B" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- TAB 4: Ketangpai Sign-In Panel -->
                <Border Style="{StaticResource FluentCardElevatedStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="课堂派考勤与签到守护" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="自动监测数字、GPS、二维码和签入签出签到。按时间表巡检。" Style="{StaticResource SubheaderTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>

                            <ui:ToggleSwitch Grid.Column="1" OnContent="服务运行中" OffContent="服务已停止" 
                                             IsChecked="{Binding SignInConfig.IsServiceRunning}"
                                             Command="{Binding ToggleSignInServiceCommand}" />
                        </Grid>

                        <!-- GPS Config -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="签到位置描述" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding SignInConfig.LocationAddress, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="纬度 (Latitude)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding SignInConfig.Latitude, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="经度 (Longitude)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding SignInConfig.Longitude, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Schedule Items Table -->
                        <TextBlock Text="课程监听时间表" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding SignInConfig.Schedules}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,2" CornerRadius="8" Background="#F1F5F9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Padding="6,2" CornerRadius="4" Background="#E0E7FF" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding DayOfWeekDisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#3730A3" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CourseName}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" />
                                                <TextBlock Text="{Binding ClassId, StringFormat='{} (ID: {0})'}" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding TimeRangeDisplay}" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                                            <ui:Button Grid.Column="3" Appearance="Danger" Icon="{ui:SymbolIcon Symbol=Delete24}" Padding="6,4"
                                                       Command="{Binding DataContext.DeleteSignInScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Schedule Inline Form -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Text="{Binding NewScheduleCourseName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="课程名称" Margin="0,0,6,0" />
                            <ui:TextBox Grid.Column="1" Text="{Binding NewScheduleClassId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Class ID" Margin="0,0,6,0" />
                            <ui:TextBox Grid.Column="2" Text="{Binding NewScheduleStartTime, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="开始 08:00" Margin="0,0,6,0" />
                            <ui:TextBox Grid.Column="3" Text="{Binding NewScheduleEndTime, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="结束 09:40" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="4" Appearance="Primary" Content="添加课程" Icon="{ui:SymbolIcon Symbol=Add24}" 
                                       Command="{Binding AddSignInScheduleCommand}" Padding="14,8" />
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- TAB 5: AI Smart Course Panel -->
                <Border Style="{StaticResource FluentCardElevatedStyle}">
                    <StackPanel>
                        <TextBlock Text="知到 AI 智能课程助手" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="自动调度文档解析大模型 (Moonshot) 提取课件语义，快速完成知识点考核与考试过关。" 
                                   Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,16" />

                        <WrapPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch Content="提取课件 PPT 关键知识点" IsChecked="{Binding AiCourseConfig.ParseCoursewarePpt}" Margin="0,0,20,0" />
                            <ui:ToggleSwitch Content="解析完成后自动清理上传文件" IsChecked="{Binding AiCourseConfig.DeleteUploadedPptAfterParsing}" />
                        </WrapPanel>

                        <ui:Button Appearance="Primary" Content="开始知到 AI 课程过关" Icon="{ui:SymbolIcon Symbol=BrainCircuit24}" 
                                   Command="{Binding StartAiCourseCommand}" Padding="20,10" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
