<UserControl x:Class="FuckRubbishClass.Views.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:FuckRubbishClass.Converters">
    <UserControl.Resources>
        <converters:StringEqualsConverter x:Key="StringEquals" />
        <Style x:Key="FeatureTab" TargetType="RadioButton">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface" CornerRadius="9" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#EFF6FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OperationPanel" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="PlatformTaskTemplate">
            <StackPanel Margin="0,3">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="VideoPanel" TargetType="Border" BasedOn="{StaticResource FluentCardElevatedStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveFeatureTab}" Value="video"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeworkPanel" TargetType="Border" BasedOn="{StaticResource FluentCardElevatedStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveFeatureTab}" Value="homework"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExamPanel" TargetType="Border" BasedOn="{StaticResource FluentCardElevatedStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveFeatureTab}" Value="exam"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AttendancePanel" TargetType="Border" BasedOn="{StaticResource FluentCardElevatedStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveFeatureTab}" Value="signin"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AiPanel" TargetType="Border" BasedOn="{StaticResource FluentCardElevatedStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveFeatureTab}" Value="aicourse"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LEARNING WORKSPACE" Style="{StaticResource KickerTextStyle}" />
                    <TextBlock Text="学习工作台" Style="{StaticResource HeaderTitleStyle}" Margin="0,6,0,4" />
                    <TextBlock Text="选择功能、账号和课程，查看真实平台数据并执行任务。" Style="{StaticResource SubheaderTextStyle}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="保存参数" Command="{Binding SaveAllConfigsCommand}" Padding="16,9" VerticalAlignment="Center" />
            </Grid>

            <Border Background="#EFF6FF" CornerRadius="9" Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#1E3A8A" TextWrapping="Wrap" />
            </Border>
            <Border Background="#FEF2F2" CornerRadius="9" Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap" />
            </Border>
            <Border Background="#F1F5F9" CornerRadius="12" Padding="4" Margin="0,0,0,16" HorizontalAlignment="Left">
                <WrapPanel>
                    <RadioButton Content="视频自学" Style="{StaticResource FeatureTab}" GroupName="Features"
                                 IsChecked="{Binding ActiveFeatureTab, Converter={StaticResource StringEquals}, ConverterParameter=video}" />
                    <RadioButton Content="平时测试" Style="{StaticResource FeatureTab}" GroupName="Features"
                                 IsChecked="{Binding ActiveFeatureTab, Converter={StaticResource StringEquals}, ConverterParameter=homework}" />
                    <RadioButton Content="考试中心" Style="{StaticResource FeatureTab}" GroupName="Features"
                                 IsChecked="{Binding ActiveFeatureTab, Converter={StaticResource StringEquals}, ConverterParameter=exam}" />
                    <RadioButton Content="课堂派考勤" Style="{StaticResource FeatureTab}" GroupName="Features"
                                 IsChecked="{Binding ActiveFeatureTab, Converter={StaticResource StringEquals}, ConverterParameter=signin}" />
                    <RadioButton Content="知到 AI 课" Style="{StaticResource FeatureTab}" GroupName="Features"
                                 IsChecked="{Binding ActiveFeatureTab, Converter={StaticResource StringEquals}, ConverterParameter=aicourse}" />
                </WrapPanel>
            </Border>

            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding TargetHint}" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="执行账号" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox x:Name="AccountSelector" ItemsSource="{Binding FeatureAccounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="DisplayTitle" MinHeight="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0" Visibility="{Binding IsCourseSelectionVisible, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="所属课程" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox x:Name="CourseSelector" ItemsSource="{Binding AvailableCourses}" SelectedItem="{Binding SelectedCourse}" DisplayMemberPath="Name" MinHeight="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <ui:Button Content="同步课程" Command="{Binding RefreshSelectedCoursesCommand}" IsEnabled="{Binding HasSelectedAccount}" Padding="12,8" Margin="0,0,6,0" />
                            <ui:Button Content="打开平台" Command="{Binding OpenPlatformCommand}" IsEnabled="{Binding HasSelectedAccount}" Padding="12,8"
                                       Visibility="{Binding CanOpenPlatform, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text="当前功能还没有可用账号。" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,12,0" />
                        <ui:Button Content="添加 / 登录账号" Command="{Binding OpenAccountsCommand}" Padding="12,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding OperationMessage}" Foreground="#475569" TextWrapping="Wrap" />
                        <ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="取消读取" Command="{Binding CancelOperationCommand}" Margin="12,0,0,0" Padding="10,5"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />
                    <ui:Button Grid.Column="2" Content="任务监控 →" Command="{Binding OpenTaskMonitorCommand}" Margin="12,0,0,0" Padding="10,5" />
                </Grid>
            </Border>

            <Border x:Name="VideoSection" Style="{StaticResource VideoPanel}">
                <StackPanel Style="{StaticResource OperationPanel}">
                    <TextBlock Text="视频自学" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="支持智慧树和学习通；任务进度与结果在任务监控中显示。" Style="{StaticResource SubheaderTextStyle}" Margin="0,4,0,20" />
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{Binding VideoConfig.PlaybackRate, StringFormat='{}播放速度：{0:F2}x'}" FontWeight="SemiBold" />
                            <Slider Minimum="0.5" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding VideoConfig.PlaybackRate}" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="{Binding VideoConfig.CompletionThreshold, StringFormat='{}智慧树完成阈值：{0:P0}'}" FontWeight="SemiBold" />
                            <Slider Minimum="0.8" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding VideoConfig.CompletionThreshold}" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="学习通浏览器" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox SelectedValue="{Binding VideoConfig.BrowserType}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Microsoft Edge" Tag="msedge" /><ComboBoxItem Content="Google Chrome" Tag="chrome" /><ComboBoxItem Content="Chromium" Tag="chromium" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <ui:ToggleSwitch Content="学习通静音播放" IsChecked="{Binding VideoConfig.IsMuted}" Margin="0,0,0,18" />
                    <ui:Button Appearance="Primary" Content="启动当前课程" Command="{Binding StartVideoStudyCommand}" IsEnabled="{Binding HasSelectedCourse}" Padding="18,10" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border x:Name="HomeworkSection" Style="{StaticResource HomeworkPanel}">
                <StackPanel Style="{StaticResource OperationPanel}">
                    <TextBlock Text="智慧树平时测试" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="按课程读取测试列表，处理单份测试，或批量处理整门课程。" Style="{StaticResource SubheaderTextStyle}" Margin="0,4,0,16" />
                    <WrapPanel Margin="0,0,0,16">
                        <ui:ToggleSwitch Content="已验证答案覆盖旧答案" IsChecked="{Binding HomeworkConfig.OverwriteWithVerifiedAnswers}" Margin="0,0,20,10" />
                        <ui:ToggleSwitch Content="未满分时自动重做" IsChecked="{Binding HomeworkConfig.AutoRedoIfNotFullScore}" Margin="0,0,20,10" />
                        <ui:ToggleSwitch Content="保持草稿保护" IsChecked="{Binding HomeworkConfig.SubmitSafeguard}" Margin="0,0,20,10" />
                        <ui:ToggleSwitch Content="作答后自动交卷" IsChecked="{Binding HomeworkConfig.AutoSubmit}" Margin="0,0,20,10" />
                    </WrapPanel>
                    <TextBlock Text="自动交卷仅在关闭草稿保护后生效；纯 AI 答案触发额外确认时保留草稿。" Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16" />
                    <StackPanel MaxWidth="330" HorizontalAlignment="Left" Margin="0,0,0,18">
                        <TextBlock Text="{Binding HomeworkConfig.AnswerDelaySeconds, StringFormat='{}每题间隔：{0:F1} 秒'}" />
                        <Slider Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding HomeworkConfig.AnswerDelaySeconds}" />
                    </StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="HomeworkSelector" ItemsSource="{Binding Homeworks}" SelectedItem="{Binding SelectedHomework}" ItemTemplate="{StaticResource PlatformTaskTemplate}" MinHeight="42" Margin="0,0,10,0" />
                        <ui:Button Grid.Column="1" Content="读取测试列表" Command="{Binding LoadHomeworksCommand}" IsEnabled="{Binding HasSelectedCourse}" Padding="14,8" />
                    </Grid>
                    <WrapPanel Margin="0,0,0,16">
                        <ui:Button Appearance="Primary" Content="作答选中测试" Command="{Binding RunSelectedHomeworkCommand}" IsEnabled="{Binding HasSelectedHomework}" Padding="14,8" Margin="0,0,8,8" />
                        <ui:Button Content="处理整门课程" Command="{Binding StartHomeworkQuizCommand}" IsEnabled="{Binding HasSelectedCourse}" Padding="14,8" Margin="0,0,8,8" />
                        <ui:Button Content="读取答案图" Command="{Binding FetchHomeworkAnswersCommand}" IsEnabled="{Binding HasSelectedHomework}" Padding="14,8" Margin="0,0,8,8" />
                        <ui:Button Content="采集至本地题库" Command="{Binding HarvestHomeworkAnswersCommand}" IsEnabled="{Binding HasSelectedHomework}" Padding="14,8" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding HomeworkResult}" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding HomeworkAnswers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" CornerRadius="9" Padding="14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Answer}" Foreground="#1D4ED8" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Issue}" Foreground="#B45309" TextWrapping="Wrap" />
                                        <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="160" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border x:Name="ExamSection" Style="{StaticResource ExamPanel}">
                <StackPanel Style="{StaticResource OperationPanel}">
                    <TextBlock Text="学习通考试中心" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="先读取当前账号的考试列表，再选择考试。验证码需在浏览器中完成。" Style="{StaticResource SubheaderTextStyle}" Margin="0,4,0,16" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ExamSelector" ItemsSource="{Binding Exams}" SelectedItem="{Binding SelectedExam}" ItemTemplate="{StaticResource PlatformTaskTemplate}" MinHeight="42" Margin="0,0,10,0" />
                        <ui:Button Grid.Column="1" Content="读取考试列表" Command="{Binding LoadExamsCommand}" IsEnabled="{Binding HasSelectedAccount}" Padding="14,8" />
                    </Grid>
                    <WrapPanel Margin="0,0,0,18">
                        <ui:ToggleSwitch Content="完成后自动交卷" IsChecked="{Binding ExamConfig.AutoSubmitExam}" Margin="0,0,24,0" />
                        <TextBlock Text="验证码等待（秒）" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:TextBox Text="{Binding ExamConfig.CaptchaTimeoutSeconds}" Width="80" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,20">
                        <ui:Button Appearance="Primary" Content="AI 作答所选考试" Command="{Binding RunSelectedExamCommand}" IsEnabled="{Binding HasSelectedExam}" Padding="16,9" Margin="0,0,8,8" />
                        <ui:Button Content="解析浏览器当前题面" Command="{Binding RunExamReadonlyAnalysisCommand}" IsEnabled="{Binding HasSelectedAccount}" Padding="16,9" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="题面解析会把当前题目发送至已配置的模型服务，不会填写或提交试卷。" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,12" />
                    <TextBox Text="{Binding ExamAnalysisResult, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="#F8FAFC" BorderBrush="#E2E8F0" Padding="14" MinHeight="150" MaxHeight="350" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <Border x:Name="AttendanceSection" Style="{StaticResource AttendancePanel}">
                <StackPanel Style="{StaticResource OperationPanel}">
                    <TextBlock Text="课堂派考勤守护" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding ServiceStatusText}" Foreground="#475569" TextWrapping="Wrap" Margin="0,8,0,16" />
                    <WrapPanel Margin="0,0,0,18">
                        <ui:Button Content="检查状态" Command="{Binding RefreshServiceStatusCommand}" IsEnabled="{Binding HasSelectedAccount}" Padding="14,8" Margin="0,0,8,8" />
                        <ui:Button Appearance="Primary" Content="启动 / 停止服务" Command="{Binding ToggleSignInServiceCommand}" IsEnabled="{Binding HasSelectedAccount}" Padding="14,8" Margin="0,0,8,8" />
                        <ui:Button Content="查看服务日志" Command="{Binding OpenSignInLogsCommand}" IsEnabled="{Binding HasSelectedAccount}" Padding="14,8" Margin="0,0,8,8" />
                        <ui:Button Content="安装服务依赖" Command="{Binding InstallSignInDependenciesCommand}" IsEnabled="{Binding HasSelectedAccount}" Padding="14,8" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="安装依赖需要联网；账号密码可在账号中心编辑。修改时间表后需重新启动服务。" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,18" />
                    <ui:ToggleSwitch Content="使用指定 GPS 坐标" IsChecked="{Binding SignInConfig.EnableGpsSpoofing}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="位置名称" Margin="0,0,0,6" /><ui:TextBox Text="{Binding SignInConfig.LocationAddress}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="纬度" Margin="0,0,0,6" /><ui:TextBox Text="{Binding SignInConfig.Latitude}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="经度" Margin="0,0,0,6" /><ui:TextBox Text="{Binding SignInConfig.Longitude}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="课程监听时间表" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding SignInConfig.Schedules}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="移除" Padding="8,4"
                                                   Command="{Binding DataContext.DeleteSignInScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeRangeDisplay}" Margin="12,0" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding DayOfWeekDisplayName}" Foreground="#1D4ED8" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel><TextBlock Text="{Binding CourseName}" FontWeight="SemiBold" /><TextBlock Text="{Binding ClassId}" Foreground="#64748B" FontSize="11" /></StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding NewScheduleCourseName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="课程名称" Margin="0,0,8,0" />
                        <ui:TextBox Grid.Column="1" Text="{Binding NewScheduleClassId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Class ID" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding NewScheduleDayOfWeek}" Margin="0,0,8,0">
                            <ComboBoxItem Content="星期日" /><ComboBoxItem Content="星期一" /><ComboBoxItem Content="星期二" /><ComboBoxItem Content="星期三" /><ComboBoxItem Content="星期四" /><ComboBoxItem Content="星期五" /><ComboBoxItem Content="星期六" />
                        </ComboBox>
                        <ui:TextBox Grid.Column="3" Text="{Binding NewScheduleStartTime, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="08:00" Margin="0,0,8,0" />
                        <ui:TextBox Grid.Column="4" Text="{Binding NewScheduleEndTime, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="09:40" />
                    </Grid>
                    <ui:Button Content="添加监听课程" Command="{Binding AddSignInScheduleCommand}" Padding="14,8" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border x:Name="AiSection" Style="{StaticResource AiPanel}">
                <StackPanel Style="{StaticResource OperationPanel}">
                    <TextBlock Text="知到 AI 智能课" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="支持课程列表选择和手动输入课程标识。外部模型在模型中心配置。" Style="{StaticResource SubheaderTextStyle}" Margin="0,4,0,18" />
                    <WrapPanel Margin="0,0,0,16">
                        <ui:ToggleSwitch Content="启用 AI 作答" IsChecked="{Binding AiCourseConfig.Enabled}" Margin="0,0,24,10" />
                        <ui:ToggleSwitch Content="使用知到内置 AI" IsChecked="{Binding AiCourseConfig.UseBuiltinPlatformAi}" Margin="0,0,24,10" />
                        <ui:ToggleSwitch Content="解析 PPT 课件" IsChecked="{Binding AiCourseConfig.ParseCoursewarePpt}" Margin="0,0,24,10" />
                        <ui:ToggleSwitch Content="解析后清理上传文件" IsChecked="{Binding AiCourseConfig.DeleteUploadedPptAfterParsing}" Margin="0,0,24,10" />
                    </WrapPanel>
                    <ui:ToggleSwitch Content="手动指定课程" IsChecked="{Binding UseManualAiCourse}" Margin="0,0,0,12" />
                    <Grid IsEnabled="{Binding UseManualAiCourse}" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding AiCourseConfig.CourseId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Course ID" Margin="0,0,12,0" />
                        <ui:TextBox Grid.Column="1" Text="{Binding AiCourseConfig.ClassId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Class ID" />
                    </Grid>
                    <ui:Button Appearance="Primary" Content="启动 AI 课程任务" Command="{Binding StartAiCourseCommand}" IsEnabled="{Binding HasSelectedAccount}" Padding="18,10" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
