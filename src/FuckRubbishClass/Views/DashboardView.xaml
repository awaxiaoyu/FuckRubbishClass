<UserControl x:Class="FuckRubbishClass.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Hero Banner -->
            <Border Style="{StaticResource FluentCardHeroStyle}" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="6" Background="#3B82F6">
                            <TextBlock Text="UNIFIED WORKSPACE · FLUENT EDITION" FontSize="10" FontWeight="Bold" Foreground="#EFF6FF" />
                        </Border>
                        <TextBlock Text="欢迎来到 FuckRubbishClass" FontSize="26" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,6" />
                        <TextBlock Text="重构统一的在线课程工作台：统一模型调度、多账号管理与跨平台功能接入。" 
                                   FontSize="13" Foreground="#BFDBFE" MaxWidth="620" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <ui:Button Appearance="Primary" Content="快速开始自学" Icon="{ui:SymbolIcon Symbol=Play24}" Padding="16,10" 
                                   Command="{Binding QuickStartVideoCommand}" Background="#FFFFFF" Foreground="#1E3A8A" FontWeight="SemiBold" Margin="0,0,10,0" />
                        <ui:Button Appearance="Secondary" Content="平时测试" Icon="{ui:SymbolIcon Symbol=DocumentBulletList24}" Padding="14,10" 
                                   Command="{Binding QuickStartHomeworkCommand}" Foreground="White" BorderBrush="#60A5FA" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metrics Overview Cards -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Metric 1: Accounts -->
                <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource FluentCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="已连接账号" Style="{StaticResource SubheaderTextStyle}" FontSize="12" />
                            <TextBlock Text="{Binding AccountCount}" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0" />
                            <TextBlock Text="多平台会话保持中" FontSize="11" Foreground="#10B981" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Person24" FontSize="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Metric 2: Courses -->
                <Border Grid.Column="1" Margin="4,0,4,0" Style="{StaticResource FluentCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="课程库总数" Style="{StaticResource SubheaderTextStyle}" FontSize="12" />
                            <TextBlock Text="{Binding CourseCount}" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0" />
                            <TextBlock Text="知到 / 超星 / 课堂派" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="#F0FDF4" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Book24" FontSize="22" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Metric 3: AI Models -->
                <Border Grid.Column="2" Margin="4,0,4,0" Style="{StaticResource FluentCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="统一模型池" Style="{StaticResource SubheaderTextStyle}" FontSize="12" />
                            <TextBlock Text="{Binding OnlineModelCount}" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0" />
                            <TextBlock Text="多角色智能调度中" FontSize="11" Foreground="#8B5CF6" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="#FAF5FF" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="22" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Metric 4: Tasks -->
                <Border Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource FluentCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="执行调度引擎" Style="{StaticResource SubheaderTextStyle}" FontSize="12" />
                            <TextBlock Text="{Binding CurrentJob.Status, FallbackValue='就绪'}" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,8,0,0" />
                            <TextBlock Text="支持随时停止与断点" FontSize="11" Foreground="#0EA5E9" Margin="0,6,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="#F0F9FF" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="22" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Two Columns Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Primary Account & Quick Features -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    
                    <!-- Active Account Overview Card -->
                    <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" />
                                    <TextBlock Text="当前首选账号" FontWeight="SemiBold" Foreground="#1E293B" FontSize="14" />
                                </StackPanel>
                                <ui:Button HorizontalAlignment="Right" Content="切换/管理账号" Padding="10,4" FontSize="12"
                                           Command="{Binding NavigateToCommand}" CommandParameter="accounts" />
                            </Grid>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="44" Height="44" CornerRadius="22" Background="#2563EB">
                                        <TextBlock Text="U" FontSize="18" FontWeight="Bold" Foreground="White" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PrimaryAccount.DisplayTitle, FallbackValue='未选择账号'}" FontWeight="SemiBold" FontSize="15" Foreground="#0F172A" />
                                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" 
                                                    Background="{Binding PrimaryAccount.Platform, Converter={StaticResource PlatformToSoftBgConverter}}">
                                                <TextBlock Text="{Binding PrimaryAccount.PlatformDisplayName, FallbackValue='未知'}" 
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding PrimaryAccount.Platform, Converter={StaticResource PlatformToColorConverter}}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PrimaryAccount.School, FallbackValue='院校未绑定'}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Padding="8,4" CornerRadius="6" Background="#ECFDF5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PrimaryAccount.StatusDescription, FallbackValue='正常'}" FontSize="11" Foreground="#059669" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Unified Feature Quick Access -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel>
                            <TextBlock Text="统一功能直达" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="重构后的功能模块统一整合，按业务流程分类，摆脱孤立仓库碎片感。" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,16" />

                            <UniformGrid Columns="2">
                                <ui:Card Margin="0,0,6,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#EFF6FF" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Play24" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="视频自学" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" />
                                            <TextBlock Text="知到/超星统一倍速" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <ui:Card Margin="6,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#F0FDF4" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="DocumentCheckmark24" FontSize="18" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="平时测验/作业" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" />
                                            <TextBlock Text="题库优先·AI保底" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <ui:Card Margin="0,4,6,0" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#FEF3C7" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CalendarCheckmark24" FontSize="18" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="考勤与签到" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" />
                                            <TextBlock Text="课堂派时间表·GPS" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <ui:Card Margin="6,4,0,0" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#FAF5FF" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="18" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="知到 AI 智能课" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" />
                                            <TextBlock Text="知识点过关·课件解析" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Live Activity Feed -->
                <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource FluentCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="系统实时活动与调度动态" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="显示来自模型调度器、任务引擎与平台的最新事件。" Style="{StaticResource SubheaderTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding RecentLogs}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="260" MaxHeight="380">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,2" CornerRadius="8" Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Top" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding TimeFormatted}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas" />
                                                <Border Margin="0,4,0,0" Padding="4,1" CornerRadius="3" Background="#E2E8F0" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Source}" FontSize="9" FontWeight="SemiBold" Foreground="#475569" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ui:Button Grid.Row="2" Content="打开完整任务日志监控" Icon="{ui:SymbolIcon Symbol=Open24}" Margin="0,12,0,0" HorizontalAlignment="Right"
                                   Command="{Binding NavigateToCommand}" CommandParameter="tasks" />
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
