<UserControl x:Class="FuckRubbishClass.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:FuckRubbishClass.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
            <StackPanel Margin="0,0,0,24">
                
                <!-- Page Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ACCOUNTS MANAGEMENT" Style="{StaticResource KickerTextStyle}" />
                        <TextBlock Text="多平台账号中心" Style="{StaticResource HeaderTitleStyle}" Margin="0,6,0,4" />
                        <TextBlock Text="统一管理智慧树、学习通、课堂派账号，支持多账号无缝切换、扫码授权与会话自动保活。" 
                                   Style="{StaticResource SubheaderTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Primary" Content="添加账号" Icon="{ui:SymbolIcon Symbol=Add24}" 
                                   Command="{Binding StartAddAccountCommand}" Margin="0,0,8,0" Padding="14,9" />
                        <ui:Button Appearance="Secondary" Content="扫码登录" Icon="{ui:SymbolIcon Symbol=QrCode24}" 
                                   Command="{Binding TriggerQrLoginCommand}" CommandParameter="{x:Static models:PlatformType.Zhihuishu}" Padding="14,9" />
                    </StackPanel>
                </Grid>

                <!-- Feedback Banner -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#2563EB" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#1E3A8A" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Add Account Form Card (Collapsible) -->
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource FluentCardElevatedStyle}" Margin="0,0,0,20" Background="#F8FAFC"
                        Visibility="{Binding IsAddingAccount, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountFormTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="保存后点击登录验证会话；编辑时密码留空会保留原密码。" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="目标平台" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox SelectedValue="{Binding NewAccountPlatform}" SelectedValuePath="Tag" HorizontalAlignment="Stretch" Padding="10,8">
                                    <ComboBoxItem Content="智慧树 / 知到" Tag="{x:Static models:PlatformType.Zhihuishu}" IsSelected="True" />
                                    <ComboBoxItem Content="学习通 / 超星" Tag="{x:Static models:PlatformType.Chaoxing}" />
                                    <ComboBoxItem Content="课堂派" Tag="{x:Static models:PlatformType.Ketangpai}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="登录账号 / 手机号 / 学号" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ui:TextBox Text="{Binding NewAccountUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如: 13800000000" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="显示昵称 (可选)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ui:TextBox Text="{Binding NewAccountDisplayName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如: 小宇" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                <TextBlock Text="学校/机构 (可选)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ui:TextBox Text="{Binding NewAccountSchool, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如: 厦门大学" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="密码 (课堂派必填/超星可选)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ui:PasswordBox Password="{Binding NewAccountPassword, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="取消" Command="{Binding CancelAddAccountCommand}" Margin="0,0,8,0" Padding="16,8" />
                            <ui:Button Appearance="Primary" Content="保存账号" Command="{Binding ConfirmAddAccountCommand}" Padding="18,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Accounts Grid List -->
                <Border Padding="30" Margin="0,0,0,16" Background="#F8FAFC" CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="添加第一个平台账号" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="智慧树支持扫码，学习通使用托管浏览器，课堂派填写账号密码。" Foreground="#64748B" Margin="0,8,0,16" TextWrapping="Wrap" />
                        <ui:Button Content="添加账号" Command="{Binding StartAddAccountCommand}" HorizontalAlignment="Center" Padding="16,8" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="340" Margin="0,0,16,16" Style="{StaticResource FluentCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Badges -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Padding="8,3" CornerRadius="6" 
                                                    Background="{Binding Platform, Converter={StaticResource PlatformToSoftBgConverter}}">
                                                <TextBlock Text="{Binding PlatformDisplayName}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding Platform, Converter={StaticResource PlatformToColorConverter}}" />
                                            </Border>

                                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="#FEF3C7"
                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="默认主账号" FontSize="10" FontWeight="SemiBold" Foreground="#B45309" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Status Indicator -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" 
                                                     Fill="{Binding Status, Converter={StaticResource AccountStatusToColorConverter}}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- User Info -->
                                    <Grid Grid.Row="1" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="44" Height="44" CornerRadius="22" Background="#2563EB">
                                            <TextBlock Text="{Binding DisplayTitle[0]}" FontSize="18" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <TextBlock Text="{Binding Username}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding School}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Details & Session info -->
                                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding StatusDescription}" FontSize="11" Foreground="#475569" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LastActiveTime, StringFormat='上次活跃: {0:yyyy-MM-dd HH:mm}'}" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <WrapPanel Grid.Row="3">
                                        <ui:Button Content="登录" Padding="8,6" Margin="0,0,6,6" FontSize="11"
                                                   Command="{Binding DataContext.LoginAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <ui:Button Content="刷新会话" Padding="8,6" Margin="0,0,6,6" FontSize="11"
                                                   Command="{Binding DataContext.RefreshSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <ui:Button Content="编辑" Padding="8,6" Margin="0,0,6,6" FontSize="11"
                                                   Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <ui:Button Content="设为主账号" Padding="8,6" Margin="0,0,6,6" FontSize="11"
                                                   Command="{Binding DataContext.SetAsPrimaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                   Visibility="{Binding IsPrimary, Converter={StaticResource InverseBoolToVisConverter}}" />
                                        <ui:Button Appearance="Danger" Content="移除" Padding="8,6" Margin="0,0,6,6" FontSize="11"
                                                   Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- QR Code Modal Dialog -->
        <Border Background="#90000000" Visibility="{Binding IsQrLoginVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Style="{StaticResource FluentCardElevatedStyle}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{Binding QrPlatformTitle}" Style="{StaticResource SectionTitleStyle}" />
                        <ui:Button HorizontalAlignment="Right" Icon="{ui:SymbolIcon Symbol=Dismiss24}" Padding="6" 
                                   Command="{Binding CloseQrLoginCommand}" />
                    </Grid>

                    <!-- QR Box -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Width="220" Height="220" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="QrCode24" FontSize="96" Foreground="#3B82F6" HorizontalAlignment="Center" />
                                <TextBlock Text="扫描二维码授权登录" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                            <Image Source="{Binding QrImage}" Stretch="Uniform" Margin="4" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding QrStatusText}" FontSize="12" Foreground="#475569" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="取消" Command="{Binding CloseQrLoginCommand}" Margin="0,0,6,0" Padding="12,8" />
                        <TextBlock Grid.Column="1" Text="平台验证后自动完成" VerticalAlignment="Center" Foreground="#64748B" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
