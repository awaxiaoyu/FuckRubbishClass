<UserControl x:Class="FuckRubbishClass.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="850" d:DesignWidth="1100">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
            <StackPanel Margin="0,0,0,24">
                
                <!-- Page Header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PREFERENCES &amp; SYSTEM" Style="{StaticResource KickerTextStyle}" />
                        <TextBlock Text="系统全局设置" Style="{StaticResource HeaderTitleStyle}" Margin="0,6,0,4" />
                        <TextBlock Text="集中配置代理网络、第三方通知渠道 (PushPlus / Bark) 与数据持久化路径。" 
                                   Style="{StaticResource SubheaderTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Secondary" Content="重新载入" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" 
                                   Command="{Binding ReloadSettingsCommand}" Margin="0,0,8,0" Padding="14,9" />
                        <ui:Button Appearance="Primary" Content="保存全部设置" Icon="{ui:SymbolIcon Symbol=Save24}" 
                                   Command="{Binding SaveSettingsCommand}" Padding="16,9" />
                    </StackPanel>
                </Grid>

                <!-- Feedback Banner -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#2563EB" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#1E3A8A" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- SECTION 1: Proxy Settings -->
                <Border Style="{StaticResource FluentCardElevatedStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="网络代理设置" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="留空默认使用系统代理。开启后所有网课请求将经由此代理中转。" Style="{StaticResource SubheaderTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>

                            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" OnContent="启用自定义代理" OffContent="使用系统默认代理" 
                                             IsChecked="{Binding Settings.EnableProxy}" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="HTTP 代理地址" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ui:TextBox Text="{Binding Settings.HttpProxy, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如: http://127.0.0.1:7890" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="HTTPS 代理地址" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ui:TextBox Text="{Binding Settings.HttpsProxy, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如: http://127.0.0.1:7890" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: Notification Channels -->
                <Border Style="{StaticResource FluentCardElevatedStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="外部消息推送渠道" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="当任务完成、遇到滑块验证码或考勤签到成功时，自动将通知推送到手机。" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,16" />

                        <!-- PushPlus -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="PushPlus 微信推送" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="国内主流微信消息通道" FontSize="11" Foreground="#64748B" />
                                </StackPanel>

                                <ui:PasswordBox Grid.Column="1" Password="{Binding Settings.PushPlusToken, UpdateSourceTrigger=PropertyChanged}" 
                                                Margin="0,0,16,0" />

                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding Settings.EnablePushPlus}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Bark -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Bark iOS 实时推送" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="苹果设备超轻量秒级提醒" FontSize="11" Foreground="#64748B" />
                                </StackPanel>

                                <ui:PasswordBox Grid.Column="1" Password="{Binding Settings.BarkToken, UpdateSourceTrigger=PropertyChanged}" 
                                                Margin="0,0,16,0" />

                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding Settings.EnableBark}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Webhook -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="自定义 Webhook" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="钉钉/飞书/企微机器人" FontSize="11" Foreground="#64748B" />
                                </StackPanel>

                                <ui:TextBox Grid.Column="1" Text="{Binding Settings.WebhookUrl, UpdateSourceTrigger=PropertyChanged}" 
                                            PlaceholderText="https://qyapi.weixin.qq.com/..." Margin="0,0,16,0" />

                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding Settings.EnableWebhook}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: Appearance & Mica -->
                <Border Style="{StaticResource FluentCardElevatedStyle}">
                    <StackPanel>
                        <TextBlock Text="外观与交互体验" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Windows 11 Fluent Design System 现代化界面渲染。" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,16" />

                        <WrapPanel>
                            <ui:ToggleSwitch Content="启用 Windows 11 Mica 亚克力动态云母材质" IsChecked="{Binding Settings.EnableMicaBackdrop}" Margin="0,0,24,8" />
                            <ui:ToggleSwitch Content="关闭时最小化到系统托盘" IsChecked="{Binding Settings.MinimizeToTray}" Margin="0,0,24,8" />
                            <ui:ToggleSwitch Content="启动时自动检查更新" IsChecked="{Binding Settings.AutoCheckUpdates}" Margin="0,0,24,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
