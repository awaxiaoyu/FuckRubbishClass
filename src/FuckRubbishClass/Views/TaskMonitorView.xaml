<UserControl x:Class="FuckRubbishClass.Views.TaskMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="850" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="EXECUTION &amp; REALTIME LOGS" Style="{StaticResource KickerTextStyle}" />
                <TextBlock Text="任务调度与日志监控" Style="{StaticResource HeaderTitleStyle}" Margin="0,6,0,4" />
                <TextBlock Text="全景监控跨平台任务执行流水线，实时输出调度控制台与模型推理日志。" 
                           Style="{StaticResource SubheaderTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="导出日志文件" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Command="{Binding ExportLogsToFileCommand}" 
                           Margin="0,0,8,0" Padding="12,8" />
                <ui:Button Content="复制日志" Icon="{ui:SymbolIcon Symbol=Copy24}" Command="{Binding CopyLogsToClipboardCommand}" 
                           Margin="0,0,8,0" Padding="12,8" />
                <ui:Button Appearance="Danger" Content="清空控制台" Icon="{ui:SymbolIcon Symbol=Delete24}" Command="{Binding ClearLogsCommand}" 
                           Padding="12,8" />
            </StackPanel>
        </Grid>

        <!-- Feedback Banner -->
        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding SuccessMessage, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#2563EB" Margin="0,0,8,0" />
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#1E3A8A" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Two Columns: Jobs History List (Left) + Terminal Console (Right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Concurrent Multi-Thread Workers Panel -->
            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource FluentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header & Concurrency Badge -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="并发任务执行看板" Style="{StaticResource SectionTitleStyle}" FontSize="15" />
                            <TextBlock Text="多账号/多平台独立线程并行刷课" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border HorizontalAlignment="Right" Padding="8,3" CornerRadius="6" Background="#EFF6FF">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#2563EB" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RunningJobs.Count, StringFormat='{}活跃: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Queue summary indicators -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#F8FAFC" Padding="6,4" CornerRadius="6" Margin="0,0,4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="运行中" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding RunningJobs.Count}" FontWeight="Bold" FontSize="13" Foreground="#2563EB" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#F8FAFC" Padding="6,4" CornerRadius="6" Margin="2,0,2,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="排队等待" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding PendingJobs.Count}" FontWeight="Bold" FontSize="13" Foreground="#D97706" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F8FAFC" Padding="6,4" CornerRadius="6" Margin="4,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="已完成" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding FinishedJobs.Count}" FontWeight="Bold" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Running & Pending Scrollable List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Section: Active Running Workers -->
                            <TextBlock Text="正在并发执行的工作单元" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,6" />
                            <ItemsControl ItemsSource="{Binding RunningJobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Top: Worker Tag & Platform & Account -->
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Padding="4,1" CornerRadius="4" Background="#2563EB" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding WorkerThreadTag}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                        <Border Padding="4,1" CornerRadius="4" Background="#E0E7FF" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding PlatformDisplayName}" FontSize="9" FontWeight="SemiBold" Foreground="#3730A3" />
                                                        </Border>
                                                        <TextBlock Text="{Binding AccountName}" FontSize="11" FontWeight="SemiBold" Foreground="#1E3A8A" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                                    </StackPanel>

                                                    <ui:Button HorizontalAlignment="Right" Appearance="Danger" Icon="{ui:SymbolIcon Symbol=Dismiss24}" Padding="4,2"
                                                               Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}" />
                                                </Grid>

                                                <!-- Course Title & Step -->
                                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding CourseName}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CurrentStep}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Progress Gauge -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="5" Foreground="#2563EB" Background="#DBEAFE" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="#2563EB" Margin="6,0,0,0" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Section: Queued Tasks -->
                            <TextBlock Text="等待执行队列" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,8,0,6"
                                       Visibility="{Binding PendingJobs.Count, Converter={StaticResource BoolToVisConverter}}" />
                            <ItemsControl ItemsSource="{Binding PendingJobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Padding="4,1" CornerRadius="3" Background="#FEF3C7" Margin="0,0,6,0">
                                                            <TextBlock Text="排队中" FontSize="9" FontWeight="Bold" Foreground="#B45309" />
                                                        </Border>
                                                        <TextBlock Text="{Binding AccountName, StringFormat='{}[{0}]'}" FontSize="10" Foreground="#64748B" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CourseName}" FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <ui:Button Grid.Column="1" Content="移出" Padding="6,2" FontSize="10"
                                                           Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Batch Control -->
                    <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                        <ui:Button Appearance="Danger" Content="终止全部并发任务" Icon="{ui:SymbolIcon Symbol=Stop24}" HorizontalAlignment="Stretch"
                                   Command="{Binding CancelAllJobsCommand}" Padding="10,7" />
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Modern Dark-themed Terminal Log Console -->
            <Border Grid.Column="1" Background="#0F172A" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Terminal Controls Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Mac/Linux style dots for authentic terminal aesthetic -->
                            <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" />
                            <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0" />
                            <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,14,0" />
                            <TextBlock Text="TERMINAL LOG CONSOLE" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding CurrentLogFilePath, StringFormat=' · 落盘日志: {0}'}" FontFamily="Consolas" FontSize="10" Foreground="#64748B" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </StackPanel>

                        <!-- Log Filters -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton Content="全部" Style="{x:Null}" Foreground="#94A3B8" FontSize="11" Margin="0,0,10,0" IsChecked="True"
                                         Click="OnFilterLogLevel" Tag="全部" />
                            <RadioButton Content="信息" Style="{x:Null}" Foreground="#60A5FA" FontSize="11" Margin="0,0,10,0"
                                         Click="OnFilterLogLevel" Tag="信息" />
                            <RadioButton Content="成功" Style="{x:Null}" Foreground="#34D399" FontSize="11" Margin="0,0,10,0"
                                         Click="OnFilterLogLevel" Tag="成功" />
                            <RadioButton Content="警告" Style="{x:Null}" Foreground="#FBBF24" FontSize="11" Margin="0,0,10,0"
                                         Click="OnFilterLogLevel" Tag="警告" />
                            <RadioButton Content="错误" Style="{x:Null}" Foreground="#F87171" FontSize="11"
                                         Click="OnFilterLogLevel" Tag="错误" />
                        </StackPanel>
                    </Grid>

                    <!-- Terminal Messages List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredLogs}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Time -->
                                    <TextBlock Text="{Binding TimeFormatted}" FontFamily="Consolas" FontSize="11" Foreground="#64748B" Margin="0,0,10,0" />

                                    <!-- Level -->
                                    <Border Grid.Column="1" Padding="4,1" CornerRadius="3" Background="{Binding LevelBadgeColor}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold" Foreground="White" FontFamily="Consolas" />
                                    </Border>

                                    <!-- Source -->
                                    <TextBlock Grid.Column="2" Text="{Binding Source, StringFormat='[{0}] '}" FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" Margin="0,0,6,0" />

                                    <!-- Message -->
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" FontFamily="Consolas" FontSize="11" Foreground="#F1F5F9" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
