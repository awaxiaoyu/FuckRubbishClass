<Application x:Class="FuckRubbishClass.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:FuckRubbishClass.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/FluentStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
            <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisConverter" />
            <converters:PlatformToColorConverter x:Key="PlatformToColorConverter" />
            <converters:PlatformToSoftBgConverter x:Key="PlatformToSoftBgConverter" />
            <converters:AccountStatusToColorConverter x:Key="AccountStatusToColorConverter" />
            <converters:LatencyToColorConverter x:Key="LatencyToColorConverter" />

            <!-- Global Fonts & Styles -->
            <FontFamily x:Key="AppFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
            <Style TargetType="Control">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
